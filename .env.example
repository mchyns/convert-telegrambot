# Application Environment (development / production)
APP_ENV=development
APP_NAME=DocPDF Bot

# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Database URL
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://docpdf:password@localhost:5432/docpdf
# For development/local (SQLite zero-configuration):
DATABASE_URL=sqlite+aiosqlite:///./docpdf.db

# Redis URL for RQ Queue
REDIS_URL=redis://localhost:6379/0
# Set to false to use internal asynchronous queue when Redis is not installed locally
USE_REDIS_QUEUE=false

# Conversion & Worker Limits
MAX_FILE_SIZE_MB=25
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_SECONDS=120
MAX_QUEUE_SIZE=100
MAX_JOBS_PER_USER_PER_HOUR=30

# Temporary File Storage
TEMP_DIR=./tmp/docpdf
FILE_TTL_MINUTES=30
CLEANUP_INTERVAL_MINUTES=15

# Logging
LOG_LEVEL=INFO

# Admin Telegram IDs (comma-separated integers)
ADMIN_TELEGRAM_IDS=123456789

# Path to LibreOffice binary (optional; auto-detected if empty)
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
# Linux example: /usr/bin/libreoffice
LIBREOFFICE_PATH=
